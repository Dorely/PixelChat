@namespace PixelChat.Components.Sprites
@using PixelChat.Art
@using PixelChat.Chat
@using PixelChat.Sprites
@inject ISpriteDocumentService Documents
@inject IFrameSetService FrameSets
@inject IArtWorkflowService Workflow
@inject SpriteExportService Exports

<section class="sprite-workspace" @onkeydown="HandleKeyAsync">
    <header class="sprite-heading">
        <h1>Sprites</h1>
        <button class="sprite-picker-trigger" disabled="@(!_ready)" aria-label="Choose sprite" aria-haspopup="dialog" @onclick="OpenPickerAsync"><span>@(_documents.FirstOrDefault(d => d.Id == _documentId)?.Name ?? "Choose a sprite")</span><span aria-hidden="true">▦</span></button>
        <button disabled="@(!_ready)" @onclick="ToggleCreate">New sprite</button>
        <button disabled="@(!_ready)" @ref="_importButton" aria-expanded="@_showImport.ToString().ToLowerInvariant()" @onclick="ToggleImportAsync">Import artwork</button>
        @if (AgentStatus is { } status) { <span role="status">@status.State @status.TargetSummary</span> }
    </header>
    @if (_showPicker)
    {
        <SpritePickerModal ProjectId="Workbench.Project.Id" Documents="_documents" ActiveDocumentId="_documentId" OnSelected="SelectDocumentAsync" OnClose="() => _showPicker = false" />
    }
    @if (_showCreate)
    {
        <div class="sprite-form">
            <label>Name <input @bind="_name" /></label>
            <label>Width <input type="number" min="1" max="8192" @bind="_width" /></label>
            <label>Height <input type="number" min="1" max="8192" @bind="_height" /></label>
            <label>Art mode <select @bind="_mode"><option value="pixel">Pixel art</option><option value="painted">Painted sprite</option></select></label>
            <button @onclick="CreateAsync">Create</button>
            <button @onclick="() => _showCreate = false">Cancel</button>
        </div>
    }
    @if (_showImport)
    {
        <div class="sprite-import" role="region" aria-label="Import artwork panel" tabindex="-1" @ref="_importPanel">
            <header class="import-heading"><h2>Import artwork</h2><button aria-label="Close import panel" @onclick="CloseImportAsync">Close ×</button></header>
            <label>Import image <InputFile OnChange="ImportAsync" accept="image/png,image/jpeg" /></label>
            <label>Import native / atlas / frames bundle <InputFile OnChange="ImportBundleAsync" accept=".zip" /></label>
            <select aria-label="Source image" value="@_sourceId" @onchange="SelectSourceAsync">
                <option value="">Choose existing artwork</option>
                @foreach (var asset in Workbench.Assets.Where(a => a.ContentType.StartsWith("image/"))) { <option value="@asset.Id">@asset.Label</option> }
            </select>
            @if (_sourceId is { } source)
            {
                <img class="source-preview" src="@($"/media/projects/{Workbench.Project.Id}/assets/{source}/full")" alt="Import source" />
                <button @onclick="DetectAsync">Detect regions</button>
                <button @onclick="ImportWholeAsync">Import whole image</button>
                <div class="sprite-form">
                    <label>X <input type="number" @bind="_regionX" /></label><label>Y <input type="number" @bind="_regionY" /></label>
                    <label>Width <input type="number" min="1" @bind="_regionW" /></label><label>Height <input type="number" min="1" @bind="_regionH" /></label>
                    <button @onclick="AddRegionAsync">Add region</button>
                </div>
                @foreach (var region in _regions)
                {
                    <label class="region-choice"><input type="checkbox" checked="@_selectedRegions.Contains(region.Id)" @onchange="e => ToggleRegion(region.Id, e)" /> @region.Name (@region.X, @region.Y; @region.Width × @region.Height)</label>
                }
                @if (_selectedRegions.Count > 0) { <button @onclick="CreateFromRegionsAsync">Create sprite from selected regions</button> }
                <p>Imports preserve artwork and alpha in painted mode. Convert to strict pixel art explicitly in the editor.</p>
            }
        </div>
    }
    @if (!string.IsNullOrEmpty(_error)) { <p role="alert" class="sprite-error">@_error</p> }
    @if (_documentId is { } id)
    {
        <NativeSpriteEditor @key="id" ProjectId="Workbench.Project.Id" DocumentId="id" Workbench="Workbench" OnChanged="ChangedAsync" OnFocusChanged="FocusChangedAsync" />
    }
    else { <p>Create a blank sprite or import artwork to start drawing.</p> }
</section>

@code {
    [Parameter, EditorRequired] public WorkbenchView Workbench { get; set; } = null!;
    [Parameter] public EventCallback OnChanged { get; set; }
    [Parameter] public Guid? SourceAssetId { get; set; }
    [Parameter] public EventCallback<Guid> OnSourceAssetChanged { get; set; }
    [Parameter] public EventCallback<WorkspaceSpritesVisibleState> OnVisibleStateChanged { get; set; }
    [Parameter] public WorkspaceSpriteAgentStatus? AgentStatus { get; set; }
    private Guid? _documentId, _sourceId, _projectId;
    private SpriteEditorFocus? _focus;
    private IReadOnlyList<FrameSetSummaryView> _documents = [];
    private IReadOnlyList<SourceRegionView> _regions = [];
    private readonly HashSet<Guid> _selectedRegions = [];
    private bool _showCreate, _showImport, _showPicker, _focusImport, _ready;
    private ElementReference _importPanel, _importButton;
    private string _name = "New sprite", _mode = "pixel";
    private string? _error;
    private int _width = 64, _height = 64, _regionX, _regionY, _regionW = 64, _regionH = 64;
    protected override async Task OnParametersSetAsync()
    {
        if (_projectId != Workbench.Project.Id || _documentId != Workbench.Project.ActiveFrameSetId)
        {
            _projectId = Workbench.Project.Id; _documentId = Workbench.Project.ActiveFrameSetId;
            _documents = await FrameSets.ListFrameSetsAsync(Workbench.Project.Id);
        }
        if (SourceAssetId is { } source && _sourceId != source) { _sourceId = source; _showImport = true; _showCreate = false; _showPicker = false; _focusImport = true; await LoadRegionsAsync(); }
        _ready = true;
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusImport && _showImport) { _focusImport = false; await _importPanel.FocusAsync(preventScroll: true); }
    }
    private void ToggleCreate() { _showCreate = !_showCreate; _showImport = false; }
    private async Task ToggleImportAsync()
    {
        if (_showImport) await CloseImportAsync();
        else { _showCreate = false; _showImport = true; _focusImport = true; }
    }
    private async Task CloseImportAsync() { _showImport = false; _focusImport = false; await _importButton.FocusAsync(preventScroll: true); }
    private async Task HandleKeyAsync(KeyboardEventArgs e)
    {
        if (e.Key != "Escape") return;
        if (_showImport) await CloseImportAsync();
        _showCreate = false;
    }
    private Task OpenPickerAsync() => RunAsync(async () =>
    {
        _documents = await FrameSets.ListFrameSetsAsync(Workbench.Project.Id);
        _showCreate = false; _showImport = false; _showPicker = true;
    });
    private async Task RunAsync(Func<Task> action) { try { _error = null; await action(); } catch (Exception ex) { _error = ex.Message; } }
    private Task CreateAsync() => RunAsync(async () => { var s = await Documents.CreateAsync(Workbench.Project.Id, _name, _width, _height, _mode); _showCreate = false; await ActivateAsync(s.DocumentId); });
    private async Task ActivateAsync(Guid id)
    {
        await FrameSets.SetActiveFrameSetAsync(Workbench.Project.Id, id); _documentId = id;
        _documents = await FrameSets.ListFrameSetsAsync(Workbench.Project.Id); await ChangedAsync();
    }
    private Task SelectDocumentAsync(Guid id) => RunAsync(async () => { _showPicker = false; await ActivateAsync(id); });
    private Task SelectSourceAsync(ChangeEventArgs e) => RunAsync(async () => { if (Guid.TryParse(e.Value?.ToString(), out var id)) { _sourceId = id; await LoadRegionsAsync(); await OnSourceAssetChanged.InvokeAsync(id); } });
    private Task ImportAsync(InputFileChangeEventArgs e) => RunAsync(async () =>
    {
        using var data = new MemoryStream(); await e.File.OpenReadStream(64 * 1024 * 1024).CopyToAsync(data);
        var asset = await Workflow.ImportAssetAsync(Workbench.Project.Id, new(e.File.Name, e.File.ContentType, data.ToArray(), Path.GetFileNameWithoutExtension(e.File.Name), SwitchToEdit: false));
        _sourceId = asset.Id; await OnSourceAssetChanged.InvokeAsync(asset.Id); await LoadRegionsAsync(); await OnChanged.InvokeAsync();
    });
    private Task ImportBundleAsync(InputFileChangeEventArgs e) => RunAsync(async () =>
    {
        using var data = new MemoryStream(); await e.File.OpenReadStream(SpriteExportService.MaxBundleBytes).CopyToAsync(data);
        var imported = await Exports.ImportAsync(Workbench.Project.Id, data.ToArray()); _showImport = false; await ActivateAsync(imported.Snapshot.DocumentId);
    });
    private async Task LoadRegionsAsync() { _selectedRegions.Clear(); _regions = _sourceId is { } id ? await FrameSets.ListSourceRegionsAsync(Workbench.Project.Id, id) : []; }
    private Task DetectAsync() => RunAsync(async () => { if (_sourceId is { } id) { _regions = await FrameSets.DetectSourceRegionsAsync(Workbench.Project.Id, new(id)); foreach (var r in _regions) _selectedRegions.Add(r.Id); } });
    private Task ImportWholeAsync() => RunAsync(async () =>
    {
        if (_sourceId is not { } id) return;
        var image = await Workflow.GetAssetFullImageAsync(Workbench.Project.Id, id) ?? throw new InvalidOperationException("Source image missing.");
        var raster = SpriteRaster.Decode(image.Data); var bitmap = raster.Encode(); var layer = new SpriteLayer { Name = "Artwork" };
        var doc = new SpriteDocument { Name = _name, Specification = new() { Width = raster.Width, Height = raster.Height }, Layers = [layer], Frames = [new() { Width = raster.Width, Height = raster.Height, Cels = new() { [layer.Id] = bitmap.Hash } }] };
        var created = await Documents.ImportAsync(Workbench.Project.Id, id, doc, [bitmap]); _showImport = false; await ActivateAsync(created.DocumentId);
    });
    private Task AddRegionAsync() => RunAsync(async () =>
    {
        if (_sourceId is not { } id) return;
        var edits = _regions.Select(r => new SourceRegionEditRequest(r.Id, r.Name, r.X, r.Y, r.Width, r.Height, r.ShapePaths, r.RegionType, r.Order)).ToList();
        edits.Add(new(null, $"Region {edits.Count + 1}", _regionX, _regionY, _regionW, _regionH, Order: edits.Count));
        _regions = await FrameSets.SaveSourceRegionsAsync(Workbench.Project.Id, new(id, edits));
    });
    private void ToggleRegion(Guid id, ChangeEventArgs e) { if (e.Value is true) _selectedRegions.Add(id); else _selectedRegions.Remove(id); }
    private Task CreateFromRegionsAsync() => RunAsync(async () => { if (_sourceId is { } id) { var set = await FrameSets.CreateFrameSetFromRegionsAsync(Workbench.Project.Id, new(id, _selectedRegions.ToList(), _name)); _showImport = false; await ActivateAsync(set.Id); } });
    private async Task ChangedAsync()
    {
        await OnChanged.InvokeAsync();
        if (_documentId is { } id)
        {
            var s = await Documents.ReadAsync(Workbench.Project.Id, id);
            await OnVisibleStateChanged.InvokeAsync(new(ActiveFrameSet: new(id, s.Document.Name, _sourceId, s.Document.Specification.Width, s.Document.Specification.Height, s.Document.Frames.Count), Mode: "frames", ActiveFrameSetId: id, AgentStatus: AgentStatus, ActiveFrameId: _focus?.FrameId, ActiveLayerId: _focus?.LayerId, DocumentRevision: s.Revision));
        }
    }
    private async Task FocusChangedAsync(SpriteEditorFocus focus)
    {
        _focus = focus;
        await OnVisibleStateChanged.InvokeAsync(new(Mode: "frames", ActiveFrameSetId: _documentId, ActiveFrameId: focus.FrameId, ActiveLayerId: focus.LayerId, DocumentRevision: focus.Revision, AgentStatus: AgentStatus));
    }
}
