@namespace PixelChat.Components.Sprites
@using PixelChat.Art
@implements IAsyncDisposable
@inject IJSRuntime JS

<dialog class="sprite-picker" aria-labelledby="sprite-picker-title" @ref="_dialog">
    <header><div><h2 id="sprite-picker-title">Choose a sprite</h2><p>Open a sprite to continue editing.</p></div><button aria-label="Close sprite picker" @onclick="CloseAsync">Close ×</button></header>
    <input class="search" type="search" aria-label="Search sprites" placeholder="Search sprites…" @bind="_search" @bind:event="oninput" autofocus />
    <div class="sprite-grid">
        @foreach (var document in FilteredDocuments)
        {
            <button @key="document.Id" class="sprite-card @(document.Id == ActiveDocumentId ? "active" : "")" aria-label="@($"Open sprite {document.Name}")" aria-pressed="@((document.Id == ActiveDocumentId).ToString().ToLowerInvariant())" @onclick="() => SelectAsync(document.Id)">
                <span class="thumbnail">
                    @if (document.PreviewFrameId is { } frame)
                    {
                        <img class="@(Math.Max(document.DefaultCellWidth, document.DefaultCellHeight) <= 256 ? "compact-art" : "")" src="@($"/media/projects/{ProjectId}/sprites/{document.Id}/revisions/{document.Revision}/frames/{frame}?preview=true")" loading="lazy" decoding="async" alt="@document.Name" />
                    }
                    else { <span>No frames</span> }
                </span>
                <strong>@document.Name</strong>
                <span class="metadata">@document.DefaultCellWidth × @document.DefaultCellHeight · @document.FrameCount @(document.FrameCount == 1 ? "frame" : "frames")</span>
                @if (document.Id == ActiveDocumentId) { <span class="current">Current sprite</span> }
            </button>
        }
        @if (!FilteredDocuments.Any()) { <p class="empty">@(Documents.Count == 0 ? "No sprites yet. Create a sprite or import artwork to get started." : "No sprites match your search.")</p> }
    </div>
    <footer>@FilteredDocuments.Count() of @Documents.Count sprites</footer>
</dialog>

@code {
    [Parameter] public Guid ProjectId { get; set; }
    [Parameter] public IReadOnlyList<FrameSetSummaryView> Documents { get; set; } = [];
    [Parameter] public Guid? ActiveDocumentId { get; set; }
    [Parameter] public EventCallback<Guid> OnSelected { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    private ElementReference _dialog;
    private IJSObjectReference? _module;
    private DotNetObjectReference<SpritePickerModal>? _self;
    private string _search = "";
    private IEnumerable<FrameSetSummaryView> FilteredDocuments => Documents.Where(d => d.Name.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Sprites/SpritePickerModal.razor.js");
        _self = DotNetObjectReference.Create(this);
        await _module.InvokeVoidAsync("open", _dialog, _self);
    }
    [JSInvokable] public async Task CloseAsync()
    {
        if (_module is not null) await _module.InvokeVoidAsync("dispose", _dialog);
        await OnClose.InvokeAsync();
    }
    private async Task SelectAsync(Guid id)
    {
        if (_module is not null) await _module.InvokeVoidAsync("dispose", _dialog);
        await OnSelected.InvokeAsync(id);
    }
    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("dispose", _dialog); await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
        _self?.Dispose();
    }
}
