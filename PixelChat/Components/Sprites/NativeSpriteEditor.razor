@namespace PixelChat.Components.Sprites
@using System.Text.Json
@using PixelChat.Sprites
@using PixelChat.Art
@using PixelChat.Models
@using PixelChat.Components.Shared
@implements IAsyncDisposable
@inject ISpriteDocumentService Documents
@inject SpriteDocumentEvents Events
@inject IFrameSetService FrameSets
@inject SpriteInspectionService Inspections
@inject IJSRuntime JS

@if (_snapshot is { } snapshot && CurrentFrame is { } frame)
{
    <div class="native-editor" data-revision="@snapshot.Revision">
        <div class="native-toolbar">
            <strong>@snapshot.Document.Name</strong><span>Revision @snapshot.Revision · @snapshot.Document.Specification.ArtMode</span>
            <button disabled="@_busy" @onclick='() => HistoryAsync("undo")'>Undo</button>
            <button disabled="@_busy" @onclick='() => HistoryAsync("redo")'>Redo</button>
            <button disabled="@_busy" @onclick='() => HistoryAsync("undo", true)'>Undo task</button>
            <button @onclick="ToggleHistoryAsync">History</button>
            <button disabled="@(!_busy)" @onclick="Stop">Stop</button>
        </div>
        <div class="native-toolbar" role="toolbar" aria-label="Drawing tools">
            @foreach (var tool in Tools) { <button class="@(_tool == tool ? "active" : "")" @onclick="() => SetTool(tool)">@tool</button> }
            <label>Color <input type="color" @bind="_color" /></label>
            <label>Alpha <input type="number" min="0" max="255" @bind="_alpha" /></label>
            <label>Brush <input type="number" min="1" max="512" @bind="_size" /></label>
            <label><input type="checkbox" @bind="_filled" /> Filled</label>
            <label>Zoom <select @bind="_zoom"><option>1</option><option>2</option><option>4</option><option>8</option><option>12</option><option>16</option></select></label>
            <label><input type="checkbox" @bind="_onion" /> Onion skin</label>
        </div>
        <div class="native-main">
            <div class="canvas-scroll">
                <canvas @ref="_canvas" aria-label="Sprite drawing canvas" tabindex="0" style="width:@(frame.Width * _zoom)px;height:@(frame.Height * _zoom)px"></canvas>
                <p class="canvas-caption">@frame.Name · @frame.Width × @frame.Height · @_pointer · Drag to draw; polygon selection finishes with Enter or double-click.</p>
            </div>
            <aside>
                <h3>Layers</h3>
                @foreach (var layer in snapshot.Document.Layers.AsEnumerable().Reverse())
                {
                    <div class="layer-row @(_layerId == layer.Id ? "selected" : "")">
                        <button title="Select layer" @onclick="() => SelectLayer(layer.Id)">@(_layerId == layer.Id ? "●" : "○")</button>
                        <input aria-label="Layer name" value="@layer.Name" @onchange="e => LayerAsync(layer.Id, new { name = e.Value?.ToString() })" />
                        <label><input type="checkbox" checked="@layer.Visible" @onchange="e => LayerAsync(layer.Id, new { visible = e.Value is true })" /> Show</label>
                        <label><input type="checkbox" checked="@layer.Locked" @onchange="e => LayerAsync(layer.Id, new { locked = e.Value is true })" /> Lock</label>
                        <input aria-label="Layer opacity" type="number" min="0" max="1" step="0.1" value="@layer.Opacity" @onchange='e => LayerAsync(layer.Id, new { opacity = double.TryParse(e.Value?.ToString(), System.Globalization.CultureInfo.InvariantCulture, out var opacity) ? opacity : layer.Opacity })' />
                    </div>
                }
                <div class="actions">
                    <button @onclick='() => ApplyAsync("Add layer", new { op = "addLayer", name = "Layer" })'>Add</button>
                    <button @onclick='() => SimpleAsync("duplicateLayer")'>Duplicate</button>
                    <button @onclick='() => SimpleAsync("mergeLayer")'>Merge down</button>
                    <button @onclick='() => SimpleAsync("deleteLayer")'>Delete</button>
                    <button @onclick='() => ApplyAsync("Raise layer", new { op = "reorderLayer", layerId = _layerId, index = snapshot.Document.Layers.FindIndex(l => l.Id == _layerId) + 1 })'>Up</button>
                    <button @onclick='() => ApplyAsync("Lower layer", new { op = "reorderLayer", layerId = _layerId, index = snapshot.Document.Layers.FindIndex(l => l.Id == _layerId) - 1 })'>Down</button>
                </div>
                <h3>Selection and transforms</h3>
                <div class="actions">
                    <button @onclick='() => SimpleAsync("copy")'>Copy</button><button @onclick='() => SimpleAsync("cut")'>Cut</button>
                    <button @onclick='() => ApplyAsync("Paste", new { op = "paste", frameId = _frameId, layerId = _layerId, x = _x, y = _y })'>Paste</button>
                    <button @onclick='() => SimpleAsync("clearSelection")'>Deselect</button><button @onclick='() => SimpleAsync("clear")'>Clear</button>
                </div>
                <div class="geometry">
                    <label>X <input type="number" @bind="_x" /></label><label>Y <input type="number" @bind="_y" /></label>
                    <label>W <input type="number" min="1" @bind="_width" /></label><label>H <input type="number" min="1" @bind="_height" /></label>
                    <label>Resampling <select @bind="_resampling"><option value="nearest">Nearest</option><option value="smooth">Smooth</option></select></label>
                </div>
                <div class="actions">
                    <button @onclick='() => ApplyAsync("Translate", new { op = "translate", frameId = _frameId, layerId = _layerId, dx = _x, dy = _y })'>Translate</button>
                    <button @onclick='() => ApplyAsync("Flip horizontal", new { op = "flip", frameId = _frameId, layerId = _layerId, axis = "horizontal" })'>Flip H</button>
                    <button @onclick='() => ApplyAsync("Flip vertical", new { op = "flip", frameId = _frameId, layerId = _layerId, axis = "vertical" })'>Flip V</button>
                    <button @onclick='() => ApplyAsync("Rotate", new { op = "rotate", frameId = _frameId, layerId = _layerId, degrees = 90 })'>Rotate 90°</button>
                    <button @onclick='() => TransformSizeAsync("crop")'>Crop canvas</button><button @onclick='() => TransformSizeAsync("resize")'>Resize</button>
                </div>
                <h3>Pivots and attachments</h3>
                <label>Name <input @bind="_pivotName" /></label>
                <button @onclick='() => ApplyAsync("Set pivot", new { op = "setPivot", frameId = _frameId, name = _pivotName, x = _x, y = _y })'>Set at X,Y</button>
                @foreach (var pivot in frame.Pivots) { <div>@pivot.Key (@pivot.Value.X, @pivot.Value.Y) <button @onclick='() => ApplyAsync("Delete pivot", new { op = "deletePivot", frameId = _frameId, name = pivot.Key })'>Remove</button></div> }
                <details><summary>Production rules</summary>
                    <label>Mode <select @bind="_artMode"><option value="pixel">Pixel art</option><option value="painted">Painted</option></select></label>
                    <label>Palette (hex, comma separated)<textarea @bind="_palette"></textarea></label>
                    <label><input type="checkbox" @bind="_enforcePalette" /> Enforce palette</label>
                    <label><input type="checkbox" @bind="_binaryAlpha" /> Binary alpha</label>
                    <label><input type="checkbox" @bind="_convert" /> Explicitly convert existing pixels</label>
                    <button @onclick="SaveSpecificationAsync">Apply rules</button>
                </details>
            </aside>
        </div>
        <section class="timeline">
            <div class="native-toolbar">
                <button @onclick="() => _playing = !_playing">@(_playing ? "Stop playback" : "Play")</button>
                <button @onclick='() => ApplyAsync("Add frame", new { op = "addFrame" })'>Add frame</button>
                <button @onclick='() => SimpleAsync("duplicateFrame")'>Duplicate frame</button><button @onclick='() => SimpleAsync("deleteFrame")'>Delete frame</button>
                <label>Duration (ms) <input type="number" min="1" max="60000" value="@frame.DurationMs" @onchange='e => ApplyAsync("Frame timing", new { op = "setDuration", frameId = _frameId, durationMs = int.TryParse(e.Value?.ToString(), out var duration) ? duration : frame.DurationMs })' /></label>
                <button @onclick='() => ReorderFrameAsync(-1)'>Earlier</button><button @onclick='() => ReorderFrameAsync(1)'>Later</button>
                <label><input type="checkbox" checked="@frame.HideFromOnionSkin" @onchange='e => ApplyAsync("Onion visibility", new { op = "setFrame", frameId = _frameId, hideFromOnionSkin = e.Value is true })' /> Hide in onion skin</label>
            </div>
            <div class="frame-strip">
                @foreach (var item in snapshot.Document.Frames)
                {
                    <button class="frame-card @(_frameId == item.Id ? "active" : "")" @onclick="() => SelectFrame(item.Id)">
                        <img loading="lazy" src="@FrameUrl(item.Id)" alt="@item.Name" /><span>@item.Name</span><small>@item.DurationMs ms</small>
                    </button>
                }
            </div>
            <div class="clip-controls">
                <label>Clip <select value="@_clipName" @onchange="SelectClip"><option value="">All frames</option>@foreach (var clip in snapshot.Document.Clips) { <option>@clip.Name</option> }</select></label>
                <input aria-label="Clip name" @bind="_clipName" />
                <label>First <input type="number" min="1" max="@snapshot.Document.Frames.Count" @bind="_clipFirst" /></label><label>Last <input type="number" min="1" max="@snapshot.Document.Frames.Count" @bind="_clipLast" /></label>
                <select aria-label="Playback direction" @bind="_direction"><option value="forward">Forward</option><option value="reverse">Reverse</option><option value="pingpong">Ping-pong</option></select>
                <label><input type="checkbox" @bind="_loop" /> Loop</label><button @onclick="SaveClipAsync">Save clip</button>
                <button @onclick='() => ApplyAsync("Delete clip", new { op = "deleteClip", name = _clipName })'>Delete clip</button>
            </div>
            @if (_playing) { <SpriteAnimationPreview Frames="PlaybackFrames" Loop="_loop" PreviewKey="@($"{DocumentId}:{snapshot.Revision}:{_clipName}:{_direction}")" CssClass="native-playback" /> }
        </section>
        <details><summary>Build sheet</summary>
            <div class="geometry"><label>Columns <input type="number" min="1" @bind="_columns" /></label><label>Padding <input type="number" min="0" @bind="_padding" /></label><label>Gutter <input type="number" min="0" @bind="_gutter" /></label><label>Margin <input type="number" min="0" @bind="_margin" /></label><button @onclick="BuildAsync">Build</button></div>
            @if (_builtAsset is { } built) { <ExportPanel ProjectId="ProjectId" AssetId="built" Inline="true" /> }
        </details>
        @if (_showHistory)
        {
            <section class="history"><h3>Operation history</h3>
                @foreach (var item in _history)
                {
                    <details><summary>r@(item.Number) · @item.Source · @item.Label · @item.CreatedAt.ToLocalTime()</summary>
                        @if (item.Script is not null) { <pre>@item.Script</pre> }
                        <pre>@item.OperationsJson</pre>
                        <img src="@FrameUrl(SpriteDocument.Deserialize(item.DocumentJson).Frames[0].Id, item.Number)" alt="Revision preview" />
                        @foreach (var artifact in _inspectionHistory.GetValueOrDefault(item.Number) ?? []) { <figure><img src="@artifact.Url" alt="@artifact.Label" /><figcaption>@artifact.Label</figcaption></figure> }
                    </details>
                }
            </section>
        }
        @if (_error is not null) { <p role="alert" class="error">@_error</p> }
        <SpriteAiPanel ProjectId="ProjectId" DocumentId="DocumentId" FrameId="_frameId" LayerId="_layerId" Revision="snapshot.Revision" ArtMode="snapshot.Document.Specification.ArtMode" />
    </div>
}

@code {
    [Parameter] public Guid ProjectId { get; set; }
    [Parameter] public Guid DocumentId { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }
    [Parameter] public EventCallback<SpriteEditorFocus> OnFocusChanged { get; set; }
    private static readonly string[] Tools = ["pencil", "brush", "erase", "eyedropper", "fill", "line", "rectangle", "ellipse", "select", "polygon", "selectColor", "pivot"];
    private SpriteSnapshot? _snapshot;
    private SpriteFrame? CurrentFrame => _snapshot?.Document.Frames.FirstOrDefault(f => f.Id == _frameId);
    private Guid _frameId, _layerId;
    private ElementReference _canvas;
    private IJSObjectReference? _module;
    private DotNetObjectReference<NativeSpriteEditor>? _reference;
    private string _tool = "pencil", _color = "#ff8040", _pointer = "", _resampling = "nearest", _pivotName = "root", _artMode = "pixel", _palette = "", _clipName = "" , _direction = "forward";
    private int _alpha = 255, _size = 1, _zoom = 8, _x, _y, _width = 64, _height = 64, _clipFirst = 1, _clipLast = 1, _columns = 8, _padding, _gutter, _margin;
    private bool _filled, _onion, _playing, _loop = true, _showHistory, _busy, _enforcePalette, _binaryAlpha, _convert, _disposed;
    private string? _error;
    private IReadOnlyList<SpriteRevision> _history = [];
    private readonly Dictionary<long, IReadOnlyList<SpriteArtifactView>> _inspectionHistory = [];
    private Guid? _builtAsset;
    private CancellationTokenSource? _operation;
    private string _renderKey = "";
    protected override async Task OnInitializedAsync() { Events.Changed += DocumentChanged; await ReloadAsync(); }
    private void DocumentChanged(Guid id, long revision) { if (id == DocumentId && !_busy && !_disposed) _ = InvokeAsync(async () => { await ReloadAsync(); StateHasChanged(); }); }
    private async Task ReloadAsync()
    {
        _snapshot = await Documents.ReadAsync(ProjectId, DocumentId);
        if (_snapshot.Document.Frames.All(f => f.Id != _frameId)) _frameId = _snapshot.Document.Frames[0].Id;
        if (_snapshot.Document.Layers.All(l => l.Id != _layerId)) _layerId = _snapshot.Document.Layers[0].Id;
        _width = CurrentFrame!.Width; _height = CurrentFrame.Height; _clipLast = Math.Min(Math.Max(_clipLast, 1), _snapshot.Document.Frames.Count);
        _artMode = _snapshot.Document.Specification.ArtMode; _enforcePalette = _snapshot.Document.Specification.EnforcePalette;
        _binaryAlpha = _snapshot.Document.Specification.BinaryAlpha; _palette = string.Join(",", _snapshot.Document.Specification.Palette);
        if (_showHistory) await LoadHistoryAsync();
        _renderKey = "";
        await OnFocusChanged.InvokeAsync(new(_frameId, _layerId, _snapshot.Revision));
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_snapshot is null || CurrentFrame is null) return;
        if (_module is null) { _module = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Sprites/NativeSpriteEditor.razor.js"); _reference = DotNetObjectReference.Create(this); }
        var key = $"{_snapshot.Revision}:{_frameId}:{_layerId}:{_tool}:{_color}:{_alpha}:{_size}:{_filled}:{_onion}:{_busy}:{_zoom}";
        if (key == _renderKey) return;
        _renderKey = key;
        var index = _snapshot.Document.Frames.FindIndex(f => f.Id == _frameId);
        var onions = _onion ? _snapshot.Document.Frames.Where((f, i) => Math.Abs(i - index) == 1 && !f.HideFromOnionSkin).Select(f => FrameUrl(f.Id)).ToList() : [];
        await _module.InvokeVoidAsync("attach", _canvas, _reference, new { url = FrameUrl(_frameId), onions, CurrentFrame.Width, CurrentFrame.Height, tool = _tool, color = _color + _alpha.ToString("x2"), size = _size, filled = _filled, busy = _busy, frameId = _frameId, layerId = _layerId, revision = _snapshot.Revision, selection = _snapshot.Document.Selection, pivots = CurrentFrame.Pivots });
    }
    private string FrameUrl(Guid id, long? revision = null) => $"/media/projects/{ProjectId}/sprites/{DocumentId}/revisions/{revision ?? _snapshot!.Revision}/frames/{id}";
    private IReadOnlyList<AnimationPreviewFrame> PlaybackFrames
    {
        get
        {
            if (_snapshot is null) return [];
            var clip = _snapshot.Document.Clips.FirstOrDefault(c => c.Name == _clipName) ?? new SpriteClip { FrameIds = _snapshot.Document.Frames.Select(f => f.Id).ToList(), Direction = _direction, Loop = _loop };
            return SpriteTimeline.Sequence(_snapshot.Document.Frames.Select(f => f.Id), clip).Select(id => { var f = _snapshot.Document.Frames.Single(f => f.Id == id); return new AnimationPreviewFrame(FrameUrl(id), f.Name, f.DurationMs); }).ToList();
        }
    }
    private void SetTool(string tool) { _tool = tool; _renderKey = ""; }
    private async Task SelectLayer(Guid id) { _layerId = id; _renderKey = ""; await OnFocusChanged.InvokeAsync(new(_frameId, _layerId, _snapshot!.Revision)); }
    private async Task SelectFrame(Guid id) { _frameId = id; _width = CurrentFrame!.Width; _height = CurrentFrame.Height; _renderKey = ""; await OnFocusChanged.InvokeAsync(new(_frameId, _layerId, _snapshot!.Revision)); }
    [JSInvokable] public async Task CanvasCommand(JsonElement operation, long revision)
    {
        if (_busy || _snapshot is null) return;
        await RunAsync(async token => { await Documents.ApplyAsync(ProjectId, new(DocumentId, revision, _tool, [operation]), token); });
    }
    [JSInvokable] public Task PickColor(string color) { _color = color[..7]; _alpha = Convert.ToInt32(color[7..], 16); StateHasChanged(); return Task.CompletedTask; }
    [JSInvokable] public Task SetPointer(int x, int y) { _x = x; _y = y; _pointer = $"{x}, {y}"; StateHasChanged(); return Task.CompletedTask; }
    private Task ApplyAsync(string label, object operation) => RunAsync(async token => { if (_snapshot is not null) await Documents.ApplyAsync(ProjectId, new(DocumentId, _snapshot.Revision, label, [JsonSerializer.SerializeToElement(operation, SpriteDocument.JsonOptions)]), token); });
    private Task SimpleAsync(string op) => ApplyAsync(op, new { op, frameId = _frameId, layerId = _layerId });
    private Task LayerAsync(Guid id, object values)
    {
        var data = JsonSerializer.SerializeToElement(values).EnumerateObject().ToDictionary(p => p.Name, p => (object)p.Value);
        data["op"] = "setLayer"; data["layerId"] = id; return ApplyAsync("Layer properties", data);
    }
    private Task TransformSizeAsync(string op) => ApplyAsync(op, new { op, frameId = _frameId, layerId = _layerId, x = _x, y = _y, width = _width, height = _height, resampling = _resampling });
    private Task ReorderFrameAsync(int delta) => ApplyAsync("Reorder frame", new { op = "reorderFrame", frameId = _frameId, index = _snapshot!.Document.Frames.FindIndex(f => f.Id == _frameId) + delta });
    private Task HistoryAsync(string action, bool wholeTask = false) => RunAsync(async token => { if (_snapshot is not null) await Documents.HistoryAsync(ProjectId, DocumentId, _snapshot.Revision, action, wholeTask, token); });
    private async Task ToggleHistoryAsync() { _showHistory = !_showHistory; if (_showHistory) await LoadHistoryAsync(); }
    private async Task LoadHistoryAsync()
    {
        _history = await Documents.ListHistoryAsync(ProjectId, DocumentId);
        foreach (var item in _history) _inspectionHistory[item.Number] = await Inspections.ListAsync(ProjectId, DocumentId, item.Number);
    }
    private void SelectClip(ChangeEventArgs e)
    {
        _clipName = e.Value?.ToString() ?? ""; var clip = _snapshot?.Document.Clips.FirstOrDefault(c => c.Name == _clipName);
        if (clip is not null) { _direction = clip.Direction; _loop = clip.Loop; _clipFirst = _snapshot!.Document.Frames.FindIndex(f => f.Id == clip.FrameIds[0]) + 1; _clipLast = _snapshot.Document.Frames.FindIndex(f => f.Id == clip.FrameIds[^1]) + 1; }
    }
    private Task SaveClipAsync() => ApplyAsync("Save clip", new { op = "setClip", clip = new SpriteClip { Name = string.IsNullOrWhiteSpace(_clipName) ? "Animation" : _clipName, Direction = _direction, Loop = _loop, FrameIds = _snapshot!.Document.Frames.Skip(Math.Max(0, _clipFirst - 1)).Take(Math.Max(1, _clipLast - _clipFirst + 1)).Select(f => f.Id).ToList() } });
    private Task SaveSpecificationAsync()
    {
        var spec = _snapshot!.Document.Specification;
        var changed = new SpriteSpecification { ArtMode = _artMode, Width = spec.Width, Height = spec.Height, BinaryAlpha = _binaryAlpha, EnforcePalette = _enforcePalette, Palette = _palette.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries).ToList(), IdentityReferences = spec.IdentityReferences, MotionRequirements = spec.MotionRequirements };
        return ApplyAsync("Production rules", new { op = "setSpecification", specification = changed, convert = _convert });
    }
    private Task BuildAsync() => RunAsync(async token => { var result = await FrameSets.BuildSheetAsync(ProjectId, new(DocumentId, Columns: _columns, Padding: _padding, Gutter: _gutter, OuterMargin: _margin), token); _builtAsset = result.OutputAssetId; });
    private async Task RunAsync(Func<CancellationToken, Task> action)
    {
        if (_busy) return; _busy = true; _error = null; _operation = new();
        try { await action(_operation.Token); await ReloadAsync(); await OnChanged.InvokeAsync(); }
        catch (OperationCanceledException) { _error = "Operation cancelled."; }
        catch (Exception ex) { _error = ex.Message; await ReloadAsync(); }
        finally { _busy = false; _operation.Dispose(); _operation = null; await InvokeAsync(StateHasChanged); }
    }
    private void Stop() => _operation?.Cancel();
    public async ValueTask DisposeAsync()
    {
        _disposed = true; Events.Changed -= DocumentChanged; _operation?.Cancel();
        if (_module is not null) { try { await _module.InvokeVoidAsync("dispose", _canvas); await _module.DisposeAsync(); } catch (JSDisconnectedException) { } }
        _reference?.Dispose();
    }
}
