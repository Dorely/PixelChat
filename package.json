{
  "name": "pixelchat",
  "version": "0.3.0",
  "description": "A desktop workspace for agent-aided art creation, editing, and review",
  "author": "Dorely",
  "license": "MIT",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:browser": "npm run build && node scripts/dev-browser.mjs",
    "build": "electron-vite build && node scripts/build-agent.mjs",
    "build:agent": "node scripts/build-agent.mjs",
    "predev": "node scripts/build-agent.mjs",
    "typecheck": "tsc --noEmit",
    "rebuild": "electron-builder install-app-deps",
    "package": "npm run build && electron-builder --win nsis --x64 --publish never",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@iarna/toml": "2.2.5",
    "@modelcontextprotocol/server": "2.2.0",
    "better-sqlite3": "13.0.3",
    "js-tiktoken": "1.0.21",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.34.5",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/iarna__toml": "2.0.5",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "esbuild": "0.25.12",
    "typescript": "7.0.2",
    "vite": "7.3.6"
  }
}
